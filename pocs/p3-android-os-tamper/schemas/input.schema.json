{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mobile-finsec:p3:synthetic:input:1.0",
  "title": "CHK-07 synthetic-only input v1",
  "description": "Controlled synthetic fixture contract; no device observation, real financial app result, or official certification.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "mode": {
      "const": "synthetic"
    },
    "check_id": {
      "const": "CHK-07"
    },
    "project_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "platform": {
      "const": "aos"
    },
    "device": {
      "type": "object",
      "properties": {
        "baseline_id": {
          "type": "string",
          "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "test_id": {
          "type": "string",
          "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
        }
      },
      "required": [
        "baseline_id",
        "test_id"
      ],
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "package_id": {
          "const": "dev.finsec.synthetic"
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "package_id",
        "build_sha256"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope_id": {
                "type": "string",
                "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
              },
              "service_id": {
                "type": "string",
                "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
              },
              "checkpoint_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "scope_id",
              "service_id",
              "checkpoint_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        }
      },
      "required": [
        "profile_id",
        "scopes"
      ],
      "additionalProperties": false
    },
    "route_refs": {
      "type": "array",
      "maxItems": 0
    },
    "packet_refs": {
      "type": "array",
      "maxItems": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "phase": {
            "type": "string",
            "enum": [
              "baseline",
              "test"
            ]
          },
          "scope_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "device_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "package_id": {
            "const": "dev.finsec.synthetic"
          },
          "build_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "service_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "checkpoint_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "stock",
              "tampered",
              "unknown"
            ]
          },
          "state_proof": {
            "type": "string",
            "enum": [
              "fixture_attestation",
              "missing"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "allowed",
              "blocked",
              "launch_only",
              "crash",
              "unknown"
            ]
          },
          "oracle": {
            "type": "string",
            "enum": [
              "service_checkpoint",
              "none"
            ]
          },
          "block_reason": {
            "type": "string",
            "enum": [
              "os_tamper",
              "other",
              "unknown",
              "none"
            ]
          },
          "cost_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "observation_id",
          "phase",
          "scope_id",
          "device_id",
          "package_id",
          "build_sha256",
          "service_id",
          "checkpoint_id",
          "state",
          "state_proof",
          "outcome",
          "oracle",
          "block_reason",
          "cost_ms"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "faults": {
      "type": "object",
      "properties": {
        "interrupt_after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "interrupt_kind": {
          "type": "string",
          "enum": [
            "none",
            "timeout",
            "cancel",
            "tool_error"
          ]
        },
        "cleanup": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "interrupt_after",
        "interrupt_kind",
        "cleanup"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "mode",
    "check_id",
    "project_id",
    "session_id",
    "run_id",
    "attempt_id",
    "timestamp",
    "platform",
    "device",
    "app",
    "profile",
    "route_refs",
    "packet_refs",
    "observations",
    "faults"
  ],
  "additionalProperties": false
}
