{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mobile-finsec:p3:synthetic:evidence-index:1.0",
  "title": "CHK-07 synthetic-only evidence-index v1",
  "description": "Controlled synthetic output; semantic replay and membership/hash verification are additionally required. This schema never certifies real-device observations.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "source": {
      "const": "synthetic_fixture"
    },
    "project_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "check_id": {
      "const": "CHK-07"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "synthetic": {
            "const": true
          },
          "source": {
            "const": "synthetic_fixture"
          },
          "project_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "check_id": {
            "const": "CHK-07"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^synthetic-evidence-[0-9]{4}$"
          },
          "observation_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "event_id": {
            "type": "string",
            "pattern": "^synthetic-event-[0-9]{4}$"
          },
          "tool_call_id": {
            "type": "string",
            "pattern": "^synthetic-tool-[0-9]{4}$"
          },
          "scope_id": {
            "type": "string",
            "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "captured_at_utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "clock": {
            "const": "synthetic_logical"
          },
          "media_type": {
            "const": "application/json"
          },
          "collection_method": {
            "const": "synthetic_fixture"
          },
          "original_or_derived": {
            "const": "original_fixture_copy"
          },
          "derived_from": {
            "type": "array",
            "maxItems": 0
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relative_blob_ref": {
            "type": "string",
            "pattern": "^blobs/synthetic-evidence-[0-9]{4}\\.json$"
          }
        },
        "required": [
          "schema_version",
          "synthetic",
          "source",
          "project_id",
          "session_id",
          "run_id",
          "check_id",
          "attempt_id",
          "evidence_id",
          "observation_id",
          "event_id",
          "tool_call_id",
          "scope_id",
          "captured_at_utc",
          "clock",
          "media_type",
          "collection_method",
          "original_or_derived",
          "derived_from",
          "byte_length",
          "content_hash",
          "relative_blob_ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "source",
    "project_id",
    "session_id",
    "run_id",
    "check_id",
    "attempt_id",
    "evidence"
  ],
  "additionalProperties": false
}
