{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mobile-finsec:p3:synthetic:event:1.0",
  "title": "CHK-07 synthetic-only event v1",
  "description": "Controlled synthetic output; semantic replay and membership/hash verification are additionally required. This schema never certifies real-device observations.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "source": {
      "const": "synthetic_fixture"
    },
    "project_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "check_id": {
      "const": "CHK-07"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^synthetic-event-[0-9]{4}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "clock": {
      "const": "synthetic_logical"
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "type": {
      "type": "string",
      "enum": [
        "run_created",
        "preflight",
        "observation_attempt",
        "observation_collected",
        "execution_interrupted",
        "verification",
        "cleanup",
        "run_finalized"
      ]
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^synthetic-evidence-[0-9]{4}$"
      },
      "maxItems": 100,
      "minItems": 0,
      "uniqueItems": true
    },
    "tool_call_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^synthetic-tool-[0-9]{4}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "source",
    "project_id",
    "session_id",
    "run_id",
    "check_id",
    "attempt_id",
    "event_id",
    "sequence",
    "timestamp",
    "clock",
    "elapsed_ms",
    "type",
    "payload",
    "evidence_refs",
    "tool_call_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_created"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "preflight"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              },
              "eligible": {
                "type": "boolean"
              },
              "reason_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "OBSERVATION_MISSING",
                      "INCOMPLETE_OBSERVATION_SET",
                      "ORACLE_UNDEFINED",
                      "TARGET_MISMATCH",
                      "CONFLICTING_OBSERVATIONS",
                      "BASELINE_UNPROVEN",
                      "TAMPER_UNPROVEN",
                      "SERVICE_UNPROVEN",
                      "TAMPERED_SERVICE_ALLOWED",
                      "TAMPERED_SERVICE_BLOCKED",
                      "BLOCK_CAUSE_UNPROVEN",
                      "PRECONDITION_MISSING",
                      "RUN_CANCELLED_BEFORE_START",
                      "TOOL_TIMEOUT",
                      "RUN_CANCELLED",
                      "TOOL_ERROR",
                      "INCOMPLETE_SCOPE",
                      "ALL_SCOPES_BLOCKED",
                      "CLEANUP_FAILED",
                      "CLEANUP_UNKNOWN"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "synthetic",
              "eligible",
              "reason_code"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "observation_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              },
              "observation_id": {
                "type": "string",
                "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
              }
            },
            "required": [
              "synthetic",
              "observation_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "observation_collected"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              },
              "observation_id": {
                "type": "string",
                "pattern": "^synthetic-[a-z0-9][a-z0-9._-]{0,95}$"
              }
            },
            "required": [
              "synthetic",
              "observation_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "execution_interrupted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              },
              "execution_status": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "timed_out",
                  "cancelled",
                  "not_run"
                ]
              },
              "reason_code": {
                "type": "string",
                "enum": [
                  "OBSERVATION_MISSING",
                  "INCOMPLETE_OBSERVATION_SET",
                  "ORACLE_UNDEFINED",
                  "TARGET_MISMATCH",
                  "CONFLICTING_OBSERVATIONS",
                  "BASELINE_UNPROVEN",
                  "TAMPER_UNPROVEN",
                  "SERVICE_UNPROVEN",
                  "TAMPERED_SERVICE_ALLOWED",
                  "TAMPERED_SERVICE_BLOCKED",
                  "BLOCK_CAUSE_UNPROVEN",
                  "PRECONDITION_MISSING",
                  "RUN_CANCELLED_BEFORE_START",
                  "TOOL_TIMEOUT",
                  "RUN_CANCELLED",
                  "TOOL_ERROR",
                  "INCOMPLETE_SCOPE",
                  "ALL_SCOPES_BLOCKED",
                  "CLEANUP_FAILED",
                  "CLEANUP_UNKNOWN"
                ]
              }
            },
            "required": [
              "synthetic",
              "execution_status",
              "reason_code"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "verification"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "inconclusive"
                ]
              },
              "reason_code": {
                "type": "string",
                "enum": [
                  "OBSERVATION_MISSING",
                  "INCOMPLETE_OBSERVATION_SET",
                  "ORACLE_UNDEFINED",
                  "TARGET_MISMATCH",
                  "CONFLICTING_OBSERVATIONS",
                  "BASELINE_UNPROVEN",
                  "TAMPER_UNPROVEN",
                  "SERVICE_UNPROVEN",
                  "TAMPERED_SERVICE_ALLOWED",
                  "TAMPERED_SERVICE_BLOCKED",
                  "BLOCK_CAUSE_UNPROVEN",
                  "PRECONDITION_MISSING",
                  "RUN_CANCELLED_BEFORE_START",
                  "TOOL_TIMEOUT",
                  "RUN_CANCELLED",
                  "TOOL_ERROR",
                  "INCOMPLETE_SCOPE",
                  "ALL_SCOPES_BLOCKED",
                  "CLEANUP_FAILED",
                  "CLEANUP_UNKNOWN"
                ]
              }
            },
            "required": [
              "synthetic",
              "verdict",
              "reason_code"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cleanup"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              },
              "cleanup_status": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "unknown"
                ]
              }
            },
            "required": [
              "synthetic",
              "cleanup_status"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run_finalized"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "synthetic": {
                "const": true
              },
              "execution_status": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "timed_out",
                  "cancelled",
                  "not_run"
                ]
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "inconclusive"
                ]
              }
            },
            "required": [
              "synthetic",
              "execution_status",
              "verdict"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
